                           debugline 66
                           pushbyte 10
                           pushstring "巴蒂"
                           pushbyte 0
                           pushstring "（抬头）这个设备的调试装置在这里吧，我来试试。"
                           newarray 2
                           newarray 1
                           pushstring "看起来很认真啊。"
