                     code
                        getlocal0
                        pushscope
                        debugfile "D:\\a\\seer2-origin-as3\\seer2-origin-as3\\src;com\\taomee\\seer2\\app\\processor\\quest\\handler\\main\\quest110;QuestMapHandler_110_80561.as"
                        newactivation
                        dup
                        setlocal1
